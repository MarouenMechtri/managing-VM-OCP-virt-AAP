{
  "name": "",
  "description": "Show Cost Management charges for the user's VM project",
  "spec": [
    {
      "question_name": "OpenShift username",
      "question_description": "Reports costs for project user-<username>",
      "required": true,
      "type": "text",
      "variable": "username",
      "default": "user1"
    },
    {
      "question_name": "Cost Management username",
      "question_description": "SSO user for Cost Management API (often same as OpenShift demo user)",
      "required": true,
      "type": "text",
      "variable": "cost_username",
      "default": "user1"
    },
    {
      "question_name": "Cost Management password",
      "question_description": "SSO password (not stored in Git)",
      "required": true,
      "type": "password",
      "variable": "cost_password",
      "default": ""
    },
    {
      "question_name": "Time scope units",
      "required": true,
      "type": "multiplechoice",
      "variable": "time_scope_units",
      "choices": "day\nmonth",
      "default": "month"
    }
  ]
}
